@token = paste_token_here

# Create seller
POST http://localhost:8000/api/v1/seller HTTP/1.1
Content-Type: application/json

{
    "first_name": "Max",
    "last_name": "Bekaryukov",
    "e_mail": "bekaryukovmv@gmail.com",
    "password": "super_password_123"
}

###

# Get token by email + password
POST http://localhost:8000/api/v1/token HTTP/1.1
Content-Type: application/json

{
    "email": "bekaryukovmv@gmail.com",
    "password": "super_password_123"
}

###

# Get all sellers (without password field)
GET http://localhost:8000/api/v1/seller HTTP/1.1

###

# Get seller by id with seller books (requires Bearer token)
GET http://localhost:8000/api/v1/seller/1 HTTP/1.1
Authorization: Bearer {{token}}

###

# Update seller by id (without password/books update)
PUT http://localhost:8000/api/v1/seller/1 HTTP/1.1
Content-Type: application/json

{
    "first_name": "Updated",
    "last_name": "Seller",
    "e_mail": "updated.seller@gmail.com"
}

###

# Delete seller by id (seller books will be deleted as well)
DELETE http://localhost:8000/api/v1/seller/1 HTTP/1.1

###

# Create book (requires Bearer token)
POST http://localhost:8000/api/v1/books/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Clean Architecture",
    "author": "Robert Martin",
    "count_pages": 300,
    "year": 2025,
    "seller_id": 1
}

###

# Get books list
GET http://localhost:8000/api/v1/books/ HTTP/1.1

###

# Get single book by id
GET http://localhost:8000/api/v1/books/1 HTTP/1.1

###

# Update full book by id (requires Bearer token)
PUT http://localhost:8000/api/v1/books/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "id": 1,
    "title": "Clean Code",
    "author": "Robert Martin",
    "year": 2022,
    "pages": 310,
    "seller_id": 1
}

###

# Patch book by id
PATCH http://localhost:8000/api/v1/books/1 HTTP/1.1
Content-Type: application/json

{
    "title": "Mziri",
    "pages": 310,
    "seller_id": 1
}

###

# Delete book by id
DELETE http://localhost:8000/api/v1/books/1 HTTP/1.1

###
